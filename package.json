{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && npm run typecheck -w @aihot/web",
    "test": "node scripts/run-invariant-tests.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  }
}
